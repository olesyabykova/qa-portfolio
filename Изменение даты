import time
from datetime import datetime, timedelta
from selenium import webdriver
from selenium.webdriver.chrome.service import Service as ChromeService
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from webdriver_manager.chrome import ChromeDriverManager

# Запуск браузера
driver = webdriver.Chrome(service=ChromeService(ChromeDriverManager().install()))
driver.get("https://demoqa.com/date-picker")
driver.maximize_window()
time.sleep(2)  # Ждем загрузки страницы
# Получаем дату +10 дней
new_date = (datetime.today() + timedelta(days=10)).strftime("%m/%d/%Y")
print(new_date)

# Находим поле даты и вводим новую дату
date_input = driver.find_element(By.ID, "datePickerMonthYearInput")
date_input.send_keys(Keys.COMMAND + "a", Keys.BACKSPACE)  # Очистка поля
date_input.send_keys(new_date, Keys.RETURN)  # Ввод новой даты
print("Дата введена через поле ввода")
